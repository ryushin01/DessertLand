  "scan": [
    "src"
  ],
  "ignore": [
    "src/app/admin/",
    "src/_app/admin-api/",
    "src/_app/layouts/AdminLayout.tsx",
    "src/_pages/admin-",
    "src/widgets/admin-shell/",
    "src/features/admin-auth/",
    "src/entities/admin-",
    "src/shared/ui/admin-kit/",
    "src/features/stripe-checkout/api/admin.server.ts"
