# Stripe 테스트 키만 넣습니다. 운영 키는 코드에서 거부합니다.
STRIPE_SECRET_KEY=

# 디저트 추천에 씁니다. 없으면 규칙 기반 기본 추천으로 동작합니다.
ANTHROPIC_API_KEY=
# 기본값은 claude-opus-5-5입니다. 비용을 줄이려면 claude-haiku-5-5 등으로 바꿉니다.
ANTHROPIC_MODEL=
NEXT_PUBLIC_SENTRY_DSN=

# 공개 데모 모드. 비우거나 1이면 어드민에 "관리자로 둘러보기"가 생기고, 어드민에서 고친 상품이 같은 브라우저의 쇼핑몰에 반영됩니다.
# 0이면 쇼핑몰은 원래 동작이고 어드민은 아래 비밀번호로만 들어갑니다. 빌드할 때 값이 박힙니다.
NEXT_PUBLIC_DEMO=
# 어드민 비밀번호(12자 이상, 데모가 꺼진 빌드에서 씀). 비우면 어드민은 잠깁니다. 운영 값은 저장소에 두지 않습니다.
ADMIN_PASSWORD=
