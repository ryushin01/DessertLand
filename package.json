{
  "name": "dessert-land",
  "version": "1.2.1",
  "description": "전 세계 디저트가 모인 달콤한 나라: 10개 언어로 디저트를 소개하고 판매하는 쇼핑몰",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "panda codegen && node scripts/copy-cjk-fonts.mjs",
    "dev": "next dev",
    "build": "panda codegen && pnpm run build-storybook && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook --quiet",
    "e2e": "playwright test",
    "analyze": "next experimental-analyze",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "fonts": "node scripts/build-fonts.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/grandiflora-one": "^5.3.0",
    "@fontsource/kaisei-decol": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@sentry/browser": "^11.16.0",
    "@vercel/speed-insights": "^2.1.0",
    "country-flag-icons": "1.6.20",
    "gsap": "^3.15.1",
    "jotai": "^3.0.2",
    "lenis": "^1.3.27",
    "next": "^16.4.6",
    "next-intl": "^4.16.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@lhci/cli": "^0.16.1",
    "@pandacss/dev": "^2.6.0",
    "@pandacss/preset-base": "^2.6.0",
    "@pandacss/preset-panda": "^2.6.0",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fontverter": "2.1.0",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "steiger": "^0.10.0",
    "storybook": "^10.6.8",
    "subset-font": "2.9.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
